# TrustTune Search API - Production Environment Template
# For deploying to Easypanel, Railway, Render, Fly.io, etc.

# ============================================================
# API CONFIGURATION
# ============================================================
# Search API listens on all interfaces in production
SEARCH_API_HOST=0.0.0.0
SEARCH_API_PORT=3000

# ============================================================
# SECURITY (REQUIRED)
# ============================================================
# Secret salt for HMAC-based API key generation
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: Keep this secret! Change for your deployment!
API_SECRET_SALT=

# Admin API key for admin panel access (Phase 2)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# Rate limiting (optional)
# RATE_LIMIT_DEFAULT=100/hour

# ============================================================
# JACKETT CONFIGURATION (REQUIRED)
# ============================================================
# Your Jackett instance URL
# Get one at: https://github.com/Jackett/Jackett
# IMPORTANT: Set up your own Jackett instance for production!
JACKETT_REMOTE_URL=
JACKETT_REMOTE_API_KEY=

# Which indexer to use: "all" for all configured indexers
JACKETT_INDEXER=all

# ============================================================
# AI CONFIGURATION (OPTIONAL BUT RECOMMENDED)
# ============================================================
# AI provider: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI API key (for AI-powered ranking)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key (alternative to OpenAI)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================
# MUSICBRAINZ (OPTIONAL)
# ============================================================
# MusicBrainz API key for metadata enrichment
# Get one at: https://musicbrainz.org/doc/MusicBrainz_API
MUSICBRAINZ_API_KEY=

# ============================================================
# TORRENT SETTINGS
# ============================================================
# Minimum number of seeders required
MIN_SEEDERS=1

# Maximum number of torrents to return
MAX_TORRENTS=50

# ============================================================
# FEATURE FLAGS
# ============================================================
# Skip MusicBrainz metadata lookup (faster but less accurate)
SKIP_MUSICBRAINZ=false

# Use full AI ranking (slower, more accurate, requires AI API key)
USE_FULL_AI=false

# Use partial AI ranking (balanced speed/accuracy)
USE_PARTIAL_AI=true

# ============================================================
# PRODUCTION SETTINGS
# ============================================================
# Disable debug mode in production
DEBUG=false

# Logging level: INFO recommended for production
LOG_LEVEL=INFO
